{
  "name": "@workspace/pg-realtime",
  "version": "0.1.0",
  "description": "Reusable, read-only realtime-over-Postgres engine: logical-replication change capture + in-memory mingo query matching (smart fan-out), with pluggable leadership and pub/sub.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": { "types": "./src/index.ts", "default": "./dist/index.mjs" },
      "require": { "types": "./src/index.ts", "default": "./dist/index.js" }
    },
    "./client": {
      "import": { "types": "./src/client/index.ts", "default": "./dist/client/index.mjs" },
      "require": { "types": "./src/client/index.ts", "default": "./dist/client/index.js" }
    },
    "./socketio": {
      "import": { "types": "./src/socketio/index.ts", "default": "./dist/socketio/index.mjs" },
      "require": { "types": "./src/socketio/index.ts", "default": "./dist/socketio/index.js" }
    },
    "./nest": {
      "import": { "types": "./src/nest/index.ts", "default": "./dist/nest/index.mjs" },
      "require": { "types": "./src/nest/index.ts", "default": "./dist/nest/index.js" }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:all": "jest --runInBand",
    "dev": "nodemon"
  },
  "keywords": [
    "postgres",
    "realtime",
    "logical-replication",
    "wal",
    "mingo",
    "subscriptions",
    "cdc"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "mingo": "^6.4.15",
    "pg": "^8.13.1",
    "pg-logical-replication": "^2.0.5"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "socket.io": ">=4",
    "socket.io-client": ">=4"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "socket.io": { "optional": true },
    "socket.io-client": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@swc/core": "^1.15.32",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.10",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
